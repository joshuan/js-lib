{
  "name": "@joshuan/js-lib",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:foundations && npm run build:dependents",
    "build:foundations": "npm run build --workspace @joshuan/auth-core --workspace @joshuan/config --workspace @joshuan/http --workspace @joshuan/observability",
    "build:dependents": "npm run build --workspace @joshuan/auth-adapters --workspace @joshuan/next-nest --workspace @joshuan/testkit",
    "typecheck": "npm run build && npm run typecheck --workspaces --if-present",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "pack:check": "node scripts/pack-check.mjs",
    "ci": "npm run typecheck && npm run lint && npm test && npm run pack:check",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release": "npm run ci && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.39.1",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.9.8",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.48.1",
    "vitest": "^5.0.1"
  }
}
