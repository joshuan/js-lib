{
  "name": "@joshuan/next-nest",
  "version": "0.1.1",
  "description": "One-process Next, Nest, and Express bootstrap",
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node ../../scripts/mark-cjs.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.esm.json"
  },
  "dependencies": {
    "@joshuan/http": "0.1.1"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "express": "^4.21.0 || ^5.0.0",
    "next": "^15.5.0 || ^16.0.0"
  },
  "devDependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@types/express": "^5.0.5",
    "@types/supertest": "^7.2.1",
    "express": "^5.2.1",
    "next": "^16.0.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.1.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joshuan/js-lib.git",
    "directory": "packages/next-nest"
  },
  "license": "UNLICENSED"
}
