{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "jsx": "react-jsx",
    "incremental": false,
    "noEmit": false,
    "types": ["node"],
    "plugins": []
  }
}
